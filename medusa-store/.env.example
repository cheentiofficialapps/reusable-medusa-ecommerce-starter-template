# Railway Environment Configuration for Medusa Backend
# Copy this to .env for local development

# Database Configuration (Railway will provide DATABASE_URL automatically)
# DATABASE_URL will be automatically set by Railway PostgreSQL service

# CORS Configuration - Update these with your actual domains
STORE_CORS=https://your-storefront-domain.vercel.app
ADMIN_CORS=https://your-admin-domain.vercel.app
AUTH_CORS=https://your-backend-domain.railway.app

# Security - Generate strong secrets for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production

# Redis (optional, Railway provides Redis service)
# REDIS_URL will be automatically set by Railway Redis service

# File Storage
FILE_SERVICE_URL=https://your-backend-domain.railway.app
FILE_SERVICE_SECRET=your-file-service-secret

# Email Service (SendGrid example)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=noreply@yourdomain.com

# Payment Providers
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Medusa Configuration
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=../medusa-store-storefront

# Node Environment
NODE_ENV=production
PORT=9000
