# Medusa Backend Configuration
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Store Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us

# Publishable API Key (get from Medusa admin panel)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Payment Integration (optional)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_public_key_here

# Next.js Configuration
NODE_ENV=development

# Revalidation Secret (for on-demand revalidation)
REVALIDATE_SECRET=supersecret

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
